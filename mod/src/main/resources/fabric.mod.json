  "contact": { "sources": "https://github.com/nafehawan/lifealauncher" },
  "license": "MIT",
  "icon": "assets/lifea/icon.png",
  "environment": "client",
  "entrypoints": { "client": ["gg.lifea.core.LifeaCore"] },
  "mixins": ["lifea.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.4",
    "java": ">=21"
  }
}
